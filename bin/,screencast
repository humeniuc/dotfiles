#!/bin/bash

SCRIPT_DIR="$(dirname "$( readlink -f "${BASH_SOURCE[0]}" )")"

_error_message() {
    [ -n "$1" ] && {
        echo "$1" >&2
        command -v /bin/notify-send >/dev/null && notify-send -- "screencast" "$1"
    }
}

_notify() {
    [ -n "$1" ] && {
        echo "$1"
        command -v /bin/notify-send >/dev/null && notify-send -- "screencast" "$1"
    }
}

_exit() {
    [ -n "$1" ] && _error_message "$1"
    exit "${2:-1}"
}

_slugify() {
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g'
}

_prompt_name() {
    local prompt="Recording name"
    local default="recording"

    if command -v rofi >/dev/null; then
        printf '%s' "$default" | rofi -dmenu -p "$prompt" -monitor -4
    elif command -v zenity >/dev/null; then
        zenity --entry --text="$prompt" --entry-text="$default" --title="screencast" 2>/dev/null
    elif [ -t 0 ]; then
        read -r -p "$prompt [$default]: " name
        printf '%s' "${name:-$default}"
    else
        _exit "No prompt available (install rofi or zenity)"
    fi
}

_muxer_for_format() {
    case "$1" in
        mkv) printf '%s' "matroska" ;;
        *)   printf '%s' "$1" ;;
    esac
}

_format_is_valid() {
    local muxer
    muxer="$(_muxer_for_format "$1")"
    ffmpeg -hide_banner -muxers 2>/dev/null \
        | awk '$1 ~ /E/ { print $2 }' \
        | grep -qx -- "$muxer"
}

_codec_for_format() {
    case "$1" in
        webm) printf '%s' "libvpx-vp9" ;;
        gif)  printf '%s' "gif" ;;
        *)    printf '%s' "libx264" ;;
    esac
}

main()
{
    command -v wf-recorder >/dev/null || _exit "wf-recorder is not installed"
    command -v slurp >/dev/null || _exit "slurp is not installed"
    command -v ffmpeg >/dev/null || _exit "ffmpeg is not installed"

    local out_dir="${SCREENCAST_DIR:-$HOME/Videos}"
    [ -n "$out_dir" ] || _exit "SCREENCAST_DIR is empty"
    mkdir -p -- "$out_dir" || _exit "Cannot create directory: $out_dir"

    local format="${SCREENCAST_FORMAT:-mp4}"
    format="${format#.}"
    format="$(printf '%s' "$format" | tr '[:upper:]' '[:lower:]')"
    [ -n "$format" ] || _exit "SCREENCAST_FORMAT is empty"
    _format_is_valid "$format" || _exit "Invalid format: $format"

    local name
    name="$(_prompt_name)"
    name="$(_slugify "$name")"
    [ -n "$name" ] || _exit "Recording name is empty"

    local geometry
    geometry="$(slurp)" || _exit "Selection cancelled"
    [ -n "$geometry" ] || _exit "Selection cancelled"

    local timestamp outfile codec
    timestamp="$(date +%Y-%m-%dT%H-%M-%S)"
    outfile="${out_dir}/${timestamp}_${name}.${format}"
    codec="$(_codec_for_format "$format")"

    _notify "Recording… (Ctrl+C to stop)"
    wf-recorder -g "$geometry" -f "$outfile" -c "$codec"
    local status=$?

    # Ctrl+C stops recording; wf-recorder may exit non-zero even after a successful save
    if [ -s "$outfile" ]; then
        _notify "Saved: $outfile"
        return 0
    fi

    _exit "Recording failed (exit $status)"
}

main "$@"
